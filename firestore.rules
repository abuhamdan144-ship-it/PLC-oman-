rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getMemberData(userId) {
      return get(/databases/$(database)/documents/members/$(userId)).data;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && getMemberData(request.auth.uid).role == 'admin';
    }

    function isApprovedMember() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && getMemberData(request.auth.uid).role == 'member'
        && getMemberData(request.auth.uid).status == 'approved';
    }

    // Private member records: visible only to the owner and administrators.
    match /members/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin() || (isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'fullName', 'email', 'mobile', 'country', 'currentLocation', 'idNumber',
          'photoURL', 'status', 'adminNote', 'registeredAt', 'emergencyContact', 'role'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'member');

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mobile', 'currentLocation', 'emergencyContact', 'photoURL'
        ])
      );

      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
          || isAdmin();
        allow create, delete: if isAdmin() || isOwner(userId);
      }
    }

    // Public QR verification exposes a deliberately minimal record and cannot be listed.
    match /publicMembers/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentLocation', 'photoURL'])
        && request.resource.data.currentLocation == getMemberData(userId).currentLocation
        && request.resource.data.photoURL == getMemberData(userId).photoURL
      );
      allow delete: if isAdmin();
    }

    match /system/{document=**} {
      allow read, write: if isAdmin();
    }

    // Reports can be filed only by an approved member and are visible only to admins.
    match /incidents/{incidentId} {
      allow create: if isApprovedMember()
        && request.resource.data.keys().hasOnly([
          'memberUid', 'memberId', 'memberName', 'memberMobile', 'subject',
          'category', 'details', 'urgency', 'createdAt', 'status'
        ])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.memberId == getMemberData(request.auth.uid).memberId
        && request.resource.data.memberName == getMemberData(request.auth.uid).fullName
        && request.resource.data.memberMobile == getMemberData(request.auth.uid).mobile
        && request.resource.data.category in ['death', 'injury', 'lost', 'found', 'wages', 'other']
        && request.resource.data.urgency in ['normal', 'urgent', 'critical']
        && request.resource.data.subject is string
        && request.resource.data.details is string
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
        && request.resource.data.status in ['new', 'reviewing', 'resolved']
        && request.resource.data.statusUpdatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Admin-managed election configuration. Members can read a specific ballot,
    // but cannot enumerate the election collection.
    match /settings/{settingId} {
      allow get: if (settingId == 'portal' && (isApprovedMember() || isAdmin())) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /elections/{electionId} {
      allow get: if isApprovedMember() || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;

      match /votes/{memberUid} {
        allow get: if isAdmin() || isOwner(memberUid);
        allow list: if isAdmin();
        allow create: if isApprovedMember()
          && isOwner(memberUid)
          && request.resource.data.keys().hasOnly(['memberUid', 'selections', 'submittedAt'])
          && request.resource.data.memberUid == request.auth.uid
          && request.resource.data.selections is map
          && request.resource.data.selections.size() > 0
          && get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'open'
          && exists(/databases/$(database)/documents/settings/portal)
          && get(/databases/$(database)/documents/settings/portal).data.activeElectionId == electionId
          && request.time < get(/databases/$(database)/documents/elections/$(electionId)).data.closesAt
          && request.resource.data.submittedAt == request.time;
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
