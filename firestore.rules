rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getMemberData(userId) {
      return get(/databases/$(database)/documents/members/$(userId)).data;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          (request.auth.token.email != null && (
            request.auth.token.email.lower() == 'plc@community.com' ||
            request.auth.token.email.lower() == 'hiapp144@gmail.com' ||
            request.auth.token.email.lower() == 'abuhamdan144@gmail.com' ||
            request.auth.token.email.lower() == 'abihamdan144@gmail.com' ||
            request.auth.token.email.lower() == 'admin@community.com' ||
            request.auth.token.email.lower().matches('.*hiapp.*') ||
            request.auth.token.email.lower().matches('.*abuhamdan.*') ||
            request.auth.token.email.lower().matches('.*abihamdan.*')
          ))
          || (exists(/databases/$(database)/documents/members/$(request.auth.uid))
              && getMemberData(request.auth.uid).role == 'admin')
        );
    }

    function isApprovedMember() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && (
          isAdmin() ||
          (getMemberData(request.auth.uid).role == 'member'
           && getMemberData(request.auth.uid).status == 'approved')
        );
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Private member records: visible to the owner and administrators.
    match /members/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if (isAdmin() || isOwner(userId))
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'mobile', 'country', 'currentLocation', 'idNumber',
          'photoURL', 'paymentReceiptURL', 'receiptReference', 'status', 'adminNote',
          'registeredAt', 'approvedAt', 'memberSince', 'memberId', 'emergencyContact', 'role'
        ])
        && (
          isAdmin() || (
            request.resource.data.status == 'pending'
            && request.resource.data.role == 'member'
            && request.resource.data.uid == request.auth.uid
          )
        );

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mobile', 'currentLocation', 'emergencyContact', 'photoURL'
        ])
      );

      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
          || isAdmin();
        allow create, delete: if isAdmin() || isOwner(userId);
      }
    }

    // Public QR verification exposes minimal non-sensitive records.
    match /publicMembers/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentLocation', 'photoURL'])
        && request.resource.data.currentLocation == getMemberData(userId).currentLocation
        && request.resource.data.photoURL == getMemberData(userId).photoURL
      );
      allow delete: if isAdmin();
    }

    match /system/{document=**} {
      allow read, write: if isAdmin();
    }

    // Incident and welfare reports submitted by members, managed by admins.
    match /incidents/{incidentId} {
      allow create: if isApprovedMember()
        && request.resource.data.keys().hasOnly([
          'memberUid', 'memberId', 'memberName', 'memberMobile', 'subject',
          'category', 'details', 'urgency', 'createdAt', 'status'
        ])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.category in ['death', 'injury', 'lost', 'found', 'wages', 'other']
        && request.resource.data.urgency in ['normal', 'urgent', 'critical']
        && request.resource.data.subject is string
        && request.resource.data.details is string
        && request.resource.data.status in ['new', 'pending_case_worker', 'reviewing', 'resolved'];
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
        && request.resource.data.status in ['new', 'pending_case_worker', 'reviewing', 'resolved'];
      allow delete: if isAdmin();
    }

    // Election configuration & active portal ballot settings.
    match /settings/{settingId} {
      allow get: if (settingId == 'portal' && (isApprovedMember() || isAdmin())) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /elections/{electionId} {
      allow get: if isApprovedMember() || isAdmin();
      allow list: if isApprovedMember() || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;

      match /votes/{memberUid} {
        allow get: if isAdmin() || isOwner(memberUid);
        allow list: if isAdmin();
        allow create: if isApprovedMember()
          && isOwner(memberUid)
          && request.resource.data.keys().hasOnly(['memberUid', 'selections', 'optionId', 'submittedAt'])
          && request.resource.data.memberUid == request.auth.uid
          && (
            ('selections' in request.resource.data && request.resource.data.selections is map)
            || ('optionId' in request.resource.data && request.resource.data.optionId is string)
          )
          && get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'open';
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
