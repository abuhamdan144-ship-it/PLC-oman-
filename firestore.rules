rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getMemberData(userId) {
      return get(/databases/$(database)/documents/members/$(userId)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        getMemberData(request.auth.uid).role == 'admin';
    }

    // Members collection
    match /members/{userId} {
      // Members can read only their own doc; admins can read all member docs.
      // Allow public verification query of member doc if query reads specific doc (or authenticated)
      allow get: if isOwner(userId) || isAdmin() || true; // Public read for QR verification by doc ID
      allow list: if isAdmin();

      // On create:
      // - Must be the user's own document (userId == request.auth.uid)
      // - status must be 'pending'
      // - role must be 'member'
      allow create: if isOwner(userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'member';

      // On update:
      // - Admins can update any field (such as status, memberId, approvedAt, adminNote)
      // - Normal members can update only their own doc, and CANNOT change:
      //   status, role, memberId, or approvedAt
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.status == resource.data.status
        && request.resource.data.role == resource.data.role
        && (!('memberId' in request.resource.data) || request.resource.data.memberId == resource.data.memberId)
        && (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == resource.data.approvedAt)
      );

      // Members cannot delete their profile doc directly (managed by admin)
      allow delete: if isAdmin();

      // Subcollection: notifications
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        // Member can update to mark as read
        allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) || isAdmin();
        allow create, delete: if isAdmin() || isOwner(userId);
      }
    }

    // System counter for generating sequential Member IDs (PLC-2026-XXXXX)
    match /system/{document=**} {
      allow read, write: if isAdmin();
    }

    // Incident / Grievance reporting collection
    match /incidents/{incidentId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
